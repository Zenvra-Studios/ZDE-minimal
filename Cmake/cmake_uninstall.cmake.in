if(NOT EXISTS "@CMAKE_BINARY_DIR@/install_manifest.txt")
    message(FATAL_ERROR "Cannot find install manifest: @CMAKE_BINARY_DIR@/install_manifest.txt. Make sure you have installed the project first.")
endif()

file(READ "@CMAKE_BINARY_DIR@/install_manifest.txt" files)
string(REGEX REPLACE "\r?\n" ";" files "${files}")

foreach(file IN LISTS files)
    if(NOT "${file}" STREQUAL "")
        if(EXISTS "$ENV{DESTDIR}${file}" OR IS_SYMLINK "$ENV{DESTDIR}${file}")
            message(STATUS "Uninstalling: $ENV{DESTDIR}${file}")
            execute_process(
                COMMAND "@CMAKE_COMMAND@" -E remove -f "$ENV{DESTDIR}${file}"
                OUTPUT_VARIABLE rm_out
                RESULT_VARIABLE rm_retval
            )
            if(NOT "${rm_retval}" EQUAL 0)
                message(FATAL_ERROR "Problem removing $ENV{DESTDIR}${file}: ${rm_out}")
            endif()
        else()
            message(STATUS "File does not exist: $ENV{DESTDIR}${file}")
        endif()
    endif()
endforeach()
