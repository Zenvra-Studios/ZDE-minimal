# ==========================================================================
# Zenvra Development Studio — .gitignore
# ==========================================================================

# --- Build outputs -------------------------------------------------------
build/
build-*/
out/
cmake-build-*/

# --- CMake ---------------------------------------------------------------
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CMakeUserPresets.json
compile_commands.json
CTestTestfile.cmake
Testing/
cmake-build-debug/
cmake-build-release/

# --- Visual Studio -------------------------------------------------------
.vs/
*.vcxproj.user
*.suo
*.sln.cache
*.user

# --- IDE / Editors -------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo

# --- Compiler / linker artifacts (in-tree leftovers) ---------------------
*.obj
*.o
*.pdb
*.ilk
*.idb
*.res
*.a
*.so
*.dylib

# --- Runtime / logs ------------------------------------------------------
*.log
*.tmp

# --- Third-party installer downloads -------------------------------------
Docs/*.exe
*.exe.manifest
*.exe.config

# --- OS junk -------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# --- Others ------------------------------------------------------------
.idea
.cache