{
  "id": "cmake",
  "displayName": "CMake",
  "extensions": [".cmake"],
  "filenames": ["CMakeLists.txt", "CMakePresets.json"],
  "firstLinePatterns": [],
  "projectMarkers": ["CMakeLists.txt"],
  "aliases": ["cmake"],
  "editorSettings": {
    "tabSize": 4,
    "insertSpaces": true,
