    "autoCloseParentheses": true,
    "autoCloseQuotes": true,
    "autoContinueComments": true
  },
  "serverAssociation": {
    "defaultServerId": "cmakels",
    "candidateExecutables": ["cmakels", "cmake-language-server", "neocmakelsp", "cmake-ls"],
    "defaultArguments": [],
    "rootMarkers": ["CMakeLists.txt", ".git"],
    "autoInstall": false
  }
}

